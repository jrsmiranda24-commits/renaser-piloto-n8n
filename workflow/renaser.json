    {
      "parameters": {
        "jsCode": "const guardado=$input.first().json;\nconst entrada=$('Validar registro').first().json;\nreturn [{json:{...guardado,clasificacion:entrada.interes==='asistir'?'prioritario':'informativo',responsable:'C'}}];"
      },
      "id": "98d7cc82-8af2-45e3-a7de-c2723a08a808",
      "name": "Clasificar interés",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;\nconst entrada=$('Validar registro').first().json;\nlet accion;\nif(!entrada.consentimiento_email){r.estado='sin_permiso_email';r.seguimiento='bloqueado_sin_permiso';accion='No preparar comunicación';}\nelse if(r.seguimiento==='completado_simulado'){accion='Omitir: seguimiento ya registrado';}\nelse if(entrada.simular_fallo){r.estado='pendiente_revision';r.seguimiento='fallo_simulado';r.intentos=String(Number(r.intentos)+1);r.responsable='D';accion='Revisar canal alternativo autorizado y reintentar';}\nelse{r.estado='seguimiento_prueba_registrado';r.seguimiento='completado_simulado';r.intentos=String(Number(r.intentos)+1);accion='Esperar respuesta explícita; no confirmar asistencia';}\nreturn [{json:{...r,accion,envio_real:false,whatsapp_api_llamada:false,canal:'email_prueba',fecha:new Date().toISOString()}}];"
      },
