        240,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const registro={...$json};\nconst escenario=registro.escenario;\nif(!['valido','fallo','recuperacion','sin_permiso'].includes(escenario)) throw new Error('Escenario no admitido');\nregistro.email=String(registro.email??'').trim().toLowerCase();\nif(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(registro.email)||!registro.nombre||!registro.evento)throw new Error('Registro inválido');\nif(typeof registro.consentimiento_email!=='boolean')throw new Error('Consentimiento explícito requerido');\nreturn [{json:{...registro,clave:registro.evento+'|'+registro.email,fecha:new Date().toISOString()}}];"
      },
      "id": "573dc328-2d07-467c-ad1b-16731b854f49",
      "name": "Validar registro",
