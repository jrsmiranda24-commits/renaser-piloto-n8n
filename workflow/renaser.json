    {
      "parameters": {
        "jsCode": "const entrada=$('Validar registro').first().json;\nconst decision=$('Preparar almacenamiento').first().json;\nconst seguido=$('Seguimiento de prueba').first().json;\nconst final=$input.first().json;\nreturn [{json:{ejecucion:$execution.id,escenario:entrada.escenario,registro_validado:entrada,\nalmacenamiento:{tabla:'RENASER_PILOTO_CONTACTOS',fila_id:final.id,clave:final.clave,duplicado:decision.duplicado},\nclasificacion:{categoria:final.clasificacion,responsable:final.responsable,metodo:'reglas explícitas'},\nseguimiento:{resultado:final.seguimiento,intentos:final.intentos,accion:seguido.accion,envio_real:false,whatsapp_api_llamada:false},\nestado_final:final,alcance:'Piloto n8n con datos ficticios; CRM y canales reales pendientes'}}];"
      },
