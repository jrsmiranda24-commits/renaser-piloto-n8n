    {
      "parameters": {
        "jsCode": "const entrada=$('Validar registro').first().json;\nconst previo=$input.first().json;\nconst duplicado=Boolean(previo.id);\nreturn [{json:{clave:entrada.clave,nombre:entrada.nombre,email:entrada.email,evento:entrada.evento,\nclasificacion:duplicado?previo.clasificacion:'pendiente',responsable:duplicado?previo.responsable:'C',\nestado:duplicado?previo.estado:'registrado',seguimiento:duplicado?previo.seguimiento:'pendiente',\nintentos:duplicado?String(previo.intentos):'0',duplicado,registro_previo_id:previo.id??null}}];"
      },
